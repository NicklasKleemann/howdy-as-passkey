# Go - project-local toolchain state (see scripts/env.sh)
/.go/
/bin/
*.test
*.out

# stray binaries from `go build ./cmd/...` without -o, which drops the artifact
# in the working directory instead of GOBIN (/bin/, ignored above)
/src/virtual-fido/howdy-bridge
/src/virtual-fido/demo
/src/virtual-fido/tools

# Python - project-local venv (uv)
/.venv/

# secrets / local key material - never commit
*.key
*.pem
vault/
*.sealed

# editor
.idea/
.vscode/
